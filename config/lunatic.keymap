#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>

//#include <interfaces/hid-trackball.dtsi>  //zmk-hid-trackball-interface

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define Main 0
#define Num 1
#define Characters 2
#define Fn 3
#define Mouse 4
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 300   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <2000>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <1000>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&lt { tapping-term-ms = <300>; };

&sk {
    quick-release;
    lazy;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <Mouse>;
        input-processors = <&zip_wheel_scaler 3 1>; //scroll faster x3
    };
};

&trackball_listener {
    scroller {
        layers = <Mouse>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    behaviors {
        laughing: laughing {
            compatible = "zmk,behavior-tap-dance";
            label = "LAUGHING";
            #binding-cells = <0>;
            bindings = <&hihi>, <&haha>;
        };

        https_http: https_http {
            compatible = "zmk,behavior-tap-dance";
            label = "HTTPS_HTTP";
            #binding-cells = <0>;
            bindings = <&https>, <&http>;
        };

        haizz_huhu: haizz_huhu {
            compatible = "zmk,behavior-tap-dance";
            label = "HAIZZ_HUHU";
            #binding-cells = <0>;
            bindings = <&haizzz>, <&huhu>;
        };

        Fn3_ctrlV: Fn3_ctrlV {
            compatible = "zmk,behavior-tap-dance";
            label = "FN3_CTRLV";
            #binding-cells = <0>;
            bindings = <&mo 3>, <&kp LC(V)>;
        };

        alt_ctrlC: alt_ctrlC {
            compatible = "zmk,behavior-tap-dance";
            label = "ALT_CTRLC";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT>, <&kp LC(C)>;
        };

        mouse4_ctrlShift: mouse4_ctrlShift {
            compatible = "zmk,behavior-tap-dance";
            label = "MOUSE4_CTRLSHIFT";
            #binding-cells = <0>;
            bindings = <&mo 4>, <&kp LS(LCTRL)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        leftParenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <19 20>;
        };

        rightParenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <20 21>;
        };

        leftBracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <31 32>;
        };

        rightBracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <32 33>;
        };

        leftBrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <43 44>;
        };

        rightBrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <44 45>;
        };

        doubleQuotes {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <19 21>;
        };

        lessThan {
            bindings = <&kp LESS_THAN>;
            key-positions = <31 33>;
        };

        greaterThan {
            bindings = <&kp GREATER_THAN>;
            key-positions = <43 45>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <33 34>;
        };

        shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <39 40>;
            layers = <0 1 2>;
        };

        return {
            bindings = <&kp RETURN>;
            key-positions = <28 41>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <28 27>;
        };

        capslock {
            bindings = <&kp CLCK>;
            key-positions = <18 19>;
        };

        capsWords {
            bindings = <&caps_word>;
            key-positions = <30 31>;
        };

        stickyShift {
            bindings = <&sk LEFT_SHIFT>;
            key-positions = <31 34>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <37 38>;
        };
    };

    macros {
        hihi: hihi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp COLON &kp RPAR &kp RPAR &kp RPAR>;
            label = "HIHI";
        };

        haha: haha {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp EQUAL &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR>;
            label = "HAHA";
        };

        yankInVim: yankInVim {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp DQT &kp PLUS &kp Y>;
            label = "YANKINVIM";
        };

        https: https {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp H &kp T &kp T &kp P &kp S &kp COLON &kp FSLH &kp FSLH>;
            label = "HTTPS";
        };

        http: http {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp H &kp T &kp T &kp P &kp COLON &kp FSLH &kp FSLH>;
            label = "HTTP";
        };

        rightArrow: rightArrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp MINUS &kp GT>;
            label = "RIGHTARROW";
        };

        leftArrow: leftArrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LT &kp MINUS>;
            label = "LEFTARROW";
        };

        notEqual: notEqual {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp EXCL &kp EQUAL>;
            label = "NOTEQUAL";
        };

        haizzz: haizzz {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp EQUAL &kp DOT &kp EQUAL>;
            label = "HAIZZZ";
        };

        huhu: huhu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp COLON &kp LPAR &kp LPAR &kp LPAR &kp LPAR>;
            label = "HUHU";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main {
            display-name = "Main";
            bindings = <
&Fn3_ctrlV  &kp N1        &kp N2     &kp N3    &kp N4     &kp N5     &kp N6   &kp N7    &kp N8                  &kp N9             &kp N0          &mouse4_ctrlShift
&alt_ctrlC  &kp Q         &kp W      &kp E     &kp R      &kp T      &kp Y    &kp U     &kp I                   &kp O              &kp P           &kp RIGHT_ALT
&kp ESC     &kp A         &kp S      &kp D     &kp F      &kp G      &kp H    &kp J     &kp K                   &kp L              &kp SEMI        &kp BACKSPACE
&kp LCTRL   &kp Z         &kp X      &kp C     &kp V      &kp B      &kp N    &kp M     &kp COMMA               &kp DOT            &kp FSLH        &kp RCTRL
            &kp LEFT_GUI  &kp LC(A)  &kp DEL   &mo 1      &kp SPACE  &kp RET  &mo 2     &kp LC(LG(LEFT_ARROW))  &kp LC(LG(RIGHT))  &kp LEFT_SHIFT
&mkp LCLK   &mkp MB3      &kp SPACE  &mkp MB4  &mkp RCLK                      &kp LEFT  &kp DOWN                &kp ENTER          &kp UP          &kp RIGHT
            >;
        };

        Num {
            display-name = "Num";
            bindings = <
&trans  &trans             &trans          &trans          &trans        &trans           &trans     &trans        &kp ASTERISK  &kp PERCENT   &kp MINUS  &trans
&trans  &kp LA(LS(LCTRL))  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans     &kp N7        &kp N8        &kp N9        &kp PLUS   &trans
&trans  &trans             &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT        &trans     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &trans     &trans
&trans  &kp PRINTSCREEN    &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &kp COMMA  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans     &trans
        &trans             &trans          &trans          &trans        &trans           &trans     &trans        &kp N0        &kp PERIOD    &trans
&trans  &trans             &trans          &trans          &trans                                    &trans        &trans        &trans        &trans     &trans
            >;

            //sensor-bindings = <&none>, <&none>;
        };

        Characters {
            display-name = "Characters";
            bindings = <
&trans  &trans           &trans       &trans       &trans      &trans       &trans          &trans         &trans        &trans     &trans        &trans
&trans  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH     &kp DOLLAR  &kp PERCENT  &kp CARET       &kp AMPERSAND  &kp ASTERISK  &kp GRAVE  &laughing     &trans
&trans  &notEqual        &leftArrow   &rightArrow  &yankInVim  &https_http  &kp MINUS       &kp EQUAL      &kp APOS      &kp BSLH   &haizz_huhu   &trans
&trans  &trans           &trans       &trans       &trans      &trans       &kp UNDERSCORE  &kp PLUS       &kp TILDE     &kp PIPE   &kp QUESTION  &kp LG(L)
        &trans           &trans       &trans       &trans      &trans       &trans          &trans         &trans        &trans     &trans
&trans  &trans           &trans       &trans       &trans                                   &trans         &trans        &trans     &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp 0 0>, <&inc_dec_kp 0 0>;
        };

        Fn {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &trans  &trans  &trans  &kp F11  &kp F12  &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans   &trans   &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans   &trans   &trans  &trans  &trans  &trans  &trans   &trans
        &trans  &trans  &trans  &trans   &trans   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp 0 0>, <&inc_dec_kp 0 0>;
        };

        Mouse {
            bindings = <
&trans  &bt BT_DISC 0  &bt BT_DISC 1   &bt BT_DISC 3   &trans           &trans           &bt BT_SEL 0       &bt BT_SEL 1  &bt BT_SEL 2  &trans  &bt BT_CLR_ALL  &trans
&trans  &mkp MCLK      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP     &msc SCRL_RIGHT  &kp C_VOLUME_UP    &trans        &trans        &trans  &trans          &trans
&trans  &mkp MB5       &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &kp HOME         &kp C_VOLUME_DOWN  &mkp LCLK     &trans        &trans  &trans          &trans
&trans  &mkp MB4       &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp END          &kp K_MUTE         &trans        &trans        &trans  &trans          &trans
        &trans         &trans          &trans          &trans           &trans           &trans             &trans        &trans        &trans  &trans
&trans  &trans         &trans          &trans          &trans                                               &trans        &trans        &trans  &trans          &trans
            >;
        };
    };
};
